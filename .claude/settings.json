{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-frontmatter.sh\"",
            "timeout": 5,
            "statusMessage": "Validating frontmatter..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-dates.sh\"",
            "timeout": 5,
            "statusMessage": "Validating dates..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-wikilinks.sh\"",
            "timeout": 5,
            "statusMessage": "Checking wikilinks..."
          }
        ]
      }
    ]
  }
}
